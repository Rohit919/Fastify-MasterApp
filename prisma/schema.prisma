// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../apps/api/src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are configured in prisma.config.ts (CLI) and the pg driver
  // adapter (runtime), as required by Prisma 7's Rust-free client.
}

// Add models below

// User model
model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  password            String
  name                String
  role                String         @default("user")
  // Email verification — null until the user verifies their address via OTP.
  emailVerifiedAt     DateTime?
  // Account lockout (brute-force protection)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  // Authorization cache/stale-token control. Bumped whenever this user's
  // effective permissions change (role assigned/removed, role perms changed).
  // A cached permission set carrying an older version must be re-resolved.
  permissionVersion   Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  roles                UserRole[]
  todos                Todo[]
  orders               Order[]

  @@index([email])
  @@map("users")
}

// Refresh token model - supports rotation, revocation, and family reuse detection
model RefreshToken {
  id        String    @id @default(cuid())
  // Only a one-way SHA-256 digest is persisted. A database leak therefore
  // cannot be used to replay active browser sessions.
  tokenHash String    @unique
  family    String    // groups all rotations from one login session
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// Todo model - demonstrates Golden Orchestrator pattern
model Todo {
  id             String   @id @default(cuid())
  title          String
  description    String?
  completed      Boolean  @default(false)
  userId         String
  idempotencyKey String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@map("todos")
}

// Example model for demonstration
model Example {
  id          String   @id @default(cuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("examples")
}

// OTP challenge — covers email_verification, password_reset, login_verification.
// Stores a HMAC-SHA256 hash of the 6-digit code, never the code itself.
model OtpChallenge {
  id          String    @id @default(cuid())
  // userId is nullable: at forgot-password time we don't yet know if the email
  // belongs to an account (we respond generically), so we store the destination
  // email instead, then resolve the user when the OTP is verified.
  userId      String?
  destination String    // normalised email address
  purpose     OtpPurpose
  codeHash    String    // HMAC-SHA256(code) — never plain text
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, purpose])
  @@index([destination, purpose])
  @@index([expiresAt])
  @@map("otp_challenges")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_VERIFICATION

  @@map("otp_purpose")
}

// Short-lived token exchanged after OTP verification to authorise a single
// password-reset submission (separate from the OTP itself so the reset form
// can be submitted without re-sending the code).
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // SHA-256 of the opaque token
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── RBAC: Roles, Permissions, and their join tables ─────────────────────────
// Authorization model: User → UserRole → Role → RolePermission → Permission.
// A user's effective permissions = the union of permissions across all roles.
// Permission keys are an application-defined registry (see api-contracts);
// the database stores assignments, not arbitrary client-injected permissions.

// A named collection of permissions. System roles (isSystem=true) are seeded
// and protected from destructive admin operations.
model Role {
  id          String           @id @default(cuid())
  // Stable, unique identifier used in seeds and privilege checks (e.g.
  // "SUPER_ADMIN"). Display-facing but treated as an internal key.
  name        String           @unique
  description String?
  // System roles are created by the seed and cannot be deleted/renamed by admins.
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

// One specific capability, keyed by the application registry (e.g. "users.read").
// Permissions are effectively immutable after deployment; the key is the contract.
model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]

  @@map("permissions")
}

// User ↔ Role assignment. assignedBy records the actor for auditability.
model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// Role ↔ Permission assignment.
model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─── Orders ──────────────────────────────────────────────────────────────────
// Monetary values are stored as integer minor units to avoid floating-point
// rounding. Product snapshots deliberately live on OrderItem so historical
// orders remain stable if a catalog changes later.
model Order {
  id             String       @id @default(cuid())
  userId         String
  status         OrderStatus  @default(PENDING)
  totalCents     Int
  idempotencyKey String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model Product {
  id         String      @id @default(cuid())
  sku        String      @unique
  name       String
  priceCents Int
  active     Boolean     @default(true)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("products")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  quantity       Int
  unitPriceCents Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED

  @@map("order_status")
}

// ─── Transactional outbox ────────────────────────────────────────────────────
// Domain writes and their event are committed together. The outbox relay claims
// pending rows and publishes idempotent BullMQ jobs, closing the DB→queue gap.
model OutboxEvent {
  id          String       @id @default(cuid())
  type        String
  aggregateId String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([aggregateId])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED

  @@map("outbox_status")
}

// ─── Audit log ────────────────────────────────────────────────────────────────
// Immutable record of high-value authorization changes (role CRUD, role
// assignment/removal, permission changes). Never store secrets in metadata.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  targetType String?
  targetId   String?
  metadata   Json?
  requestId  String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

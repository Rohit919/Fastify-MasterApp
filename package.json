{
  "name": "fastify-admin-monorepo",
  "version": "1.0.0",
  "description": "Monorepo: Fastify API + React admin, sharing TypeBox API contracts",
  "author": "DriftOS",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @app/api",
    "dev:admin": "npm run dev --workspace @app/admin",
    "build:contracts": "npm run build --workspace @app/api-contracts",
    "build:api": "npm run build --workspace @app/api",
    "build:admin": "npm run build --workspace @app/admin",
    "build": "npm run build:contracts && npm run build:api && npm run build:admin",
    "test": "npm run test --workspace @app/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:api-drift": "node scripts/check-api-drift.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "prepare": "husky install || true",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"prisma/**/*.ts\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"prisma/**/*.ts\"",
    "test:admin": "npm run test --workspace @app/admin",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.2.2",
    "eslint": "^10.10.0",
    "globals": "^16.4.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "fast-uri": "4.1.4",
    "mysql2": "3.24.4"
  }
}

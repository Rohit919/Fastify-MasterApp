{
  "name": "fastify-admin-monorepo",
  "version": "1.0.0",
  "description": "Monorepo: Fastify API + React admin, sharing TypeBox API contracts",
  "author": "DriftOS",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @app/api",
    "dev:admin": "npm run dev --workspace @app/admin",
    "build:contracts": "npm run build --workspace @app/api-contracts",
    "build:api": "npm run build --workspace @app/api",
    "build:admin": "npm run build --workspace @app/admin",
    "build": "npm run build:contracts && npm run build:api && npm run build:admin",
    "test": "npm run test --workspace @app/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:api-drift": "node scripts/check-api-drift.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "prepare": "husky install || true"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "prisma": "^5.22.0",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

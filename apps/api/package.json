{
  "name": "@app/api",
  "version": "1.0.0",
  "description": "Fastify API — Golden Orchestrator pattern",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "worker": "tsx watch --clear-screen=false src/workers/index.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@app/api-contracts": "*",
    "@fastify/auth": "^5.1.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "7.10.0",
    "@prisma/instrumentation": "7.10.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "opossum": "^10.0.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "@fastify/otel": "^0.21.0",
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.2",
    "@types/opossum": "^8.1.9",
    "@vitest/coverage-v8": "^5.0.0",
    "pino-pretty": "^10.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}

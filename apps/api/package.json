{
  "name": "@app/api",
  "version": "1.0.0",
  "description": "Fastify API — Golden Orchestrator pattern",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@app/api-contracts": "*",
    "@fastify/auth": "^4.5.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/env": "^4.3.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "@fastify/swagger": "^8.13.0",
    "@fastify/swagger-ui": "^2.0.1",
    "@fastify/type-provider-typebox": "^4.0.0",
    "@prisma/client": "^5.22.0",
    "@sinclair/typebox": "^0.32.5",
    "bcryptjs": "^3.0.3",
    "fastify": "^4.25.1",
    "fastify-plugin": "^5.1.0",
    "pino": "^8.17.2",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.6",
    "pino-pretty": "^10.3.1",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.1",
    "@vitest/coverage-v8": "^1.1.1"
  }
}

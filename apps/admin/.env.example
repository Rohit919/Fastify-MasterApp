# Admin Frontend environment (browser-safe values ONLY).
# Vite exposes variables prefixed with VITE_ to the client bundle — never put
# secrets (JWT secret, DB credentials, API keys) here.

# Base origin of the Fastify API. Leave EMPTY in local dev: Vite proxies /api to
# http://localhost:3000 (see vite.config.ts), so requests are same-origin.
# In production set the full API origin. The /api/v1 prefix is added by the
# shared endpoint registry (@app/api-contracts), so do NOT include it here.
#
# Example (production):
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Per-request network timeout in milliseconds. Requests exceeding this are
# aborted and surfaced as a TIMEOUT error. Optional; defaults to 30000 (30s).
VITE_API_TIMEOUT_MS=30000
